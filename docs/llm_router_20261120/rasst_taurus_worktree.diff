+    segments_path = Path(tmp_dir) / "__segments"
+    try:
+        pred_file.write(pred_text)
+        pred_file.flush()
+        ref_file.writelines(ref + "\n" for ref in refs)
+        ref_file.flush()
+        subprocess.run(
